# Copy to .env (never commit it). Only the variables referenced by configs/models.yaml
# (api_key_env) are read, and they are NEVER forwarded into benchmark sandboxes.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional: custom CA bundle for corporate proxies (used by the HTTP adapters).
AIBENCH_CA_BUNDLE=
# Optional: where results are written (default: ./results)
AIBENCH_RESULTS_DIR=
